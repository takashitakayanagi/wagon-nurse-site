# =====================================================================
#  WAGON 模試LP 環境変数サンプル
#  このファイルを .env.local にコピーして値を設定してください。
#  本番（GitHub Pages）の値は .github/workflows/pages.yml に書いてあります。
# =====================================================================

# 公式LINEの友だち追加URL（必須）
# 未設定の場合、LINEボタンは無効化され、コンソールに警告が出ます。
# ※ LP別に友だち追加経路を分けると、LINE側でどのLP経由か判別できます。
NEXT_PUBLIC_LINE_URL=https://page.line.me/wvr6857m

# 模擬試験の個人お申込みフォーム（未設定なら config のデフォルトを使用）
NEXT_PUBLIC_MOSHI_FORM_URL=https://forms.gle/QWdwTxHozDBj5ThL8

# 配信先のサブディレクトリ。本番は /lp/moshi。
# ローカルで確認するときは空のままにしてください。
NEXT_PUBLIC_BASE_PATH=

# サイトのルートURL（OGP画像やcanonicalの絶対URL生成に使用）
NEXT_PUBLIC_SITE_URL=https://wagon-nurse.com

# Google Analytics 4 測定ID（任意）
NEXT_PUBLIC_GA4_ID=

# Meta Pixel ID（任意）
NEXT_PUBLIC_META_PIXEL_ID=

# Microsoft Clarity ID（任意）
NEXT_PUBLIC_CLARITY_ID=
